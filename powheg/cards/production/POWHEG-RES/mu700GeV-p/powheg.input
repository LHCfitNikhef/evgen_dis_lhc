! PAPER-PLOTS-V2 production: NC DIS, 700 GeV mu- on a proton at rest
! GENERATED by powheg/production/make_cards.py from POWHEG-RES/mu1TeV-wide -- edit that script, not this card.
! Driver: powheg/production/run_res.sh 700 p
! Conventions matched to the FASER evgen-benchmark (2026-08-13):
!   NNPDF40_nnlo_as_01180, muF = muR = Q, fixed alpha_em = 1/132.119,
!   sin2thetaW = 0.22291, Q2 > 4 GeV2, massless charm (ZM-VFNS PDF)

numevts 25000        ! events per seed; the driver adds seeds until the showered target is met

ih1 13               ! lepton beam: mu-
ih2  1               ! hadron 2: 1 = proton
ebeam1 700d0        ! muon beam energy [GeV]
ebeam2 0.938d0       ! target at rest (0.938: see analysis/beams.py)
fixed_lepton_beam 1  ! single fixed-energy lepton beam
fixed_target 1       ! beam 2 at rest, mass = ebeam2

bornktmin 0d0
bornsuppfact 0d0     ! no Born suppression: flat event weights

Qmin 1.5d0           ! generation cut Q2 > 2.25: safely below the analysis cut Q2 > 4,
                     ! so radiation can migrate INTO the fiducial region (leptonic
                     ! Q2 > 4 with Born Q2 < 4); cutting at generation Q2=4 biased
                     ! sigma_fid low by ~1%
Qmax 10000d0
xmin 0d0
xmax 1d0
ymin 0d0
ymax 1d0

lhans1   331100      ! NNPDF40_nnlo_as_01180
lhans2   331100
alphas_from_pdf 1

renscfact  1d0
facscfact  1d0
runningscales 1      ! muF = muR = Q

channel_type 4       ! NC only
vtype 3              ! photon + Z exchange
smartsig 1
nores 1
olddij 0

! EW parameters: Gmu-scheme values used as fixed couplings (matched to Sherpa)
alphaem 0.0075689340670153d0   ! 1/132.119
s2w 0.22291d0

muonmass 0.10566d0

use-old-grid    1
use-old-ubound  1

ncall1 50000         ! calls per process for importance-sampling grid
itmx1 1              ! (xgriditerations handled by parallel stage 1)
ncall2 50000         ! calls per process for upper-bounding envelope
itmx2 1
foldcsi 5
foldy   5
foldphi 1
nubound 50000
iupperfsr 1

fastbtlbound 1
storemintupb 1
ubexcess_correct 1
storeinfo_rwgt 1
hdamp 0
bornzerodamp 1

withnegweights 1
flg_jacsing 1
testplots 0

xupbound 2d0
iseed    12
manyseeds 1
doublefsr 0

parallelstage 4
xgriditeration 1
