# POWHEG-RES DIS_v: the lepton-flux hook of LHCfitNikhef/DIS_with_LHC_muons
# (arXiv:2506.13889) dropped into a SEPARATE copy of the process,
# $PHYSICS24/software/powheg/powheg-dis-main/DIS_v_muflux, built with the
# unchanged Makefile.  The stock DIS_v ships a stub pdf_lepton_beam(); this
# version reads the flux from the LHAPDF set named by the LEPpdf card key,
# and -- the point -- sets every other flavour to 1e-8 rather than 0, because
# POWHEG's bad_born_kin() rejects any point whose beam-1 light-quark "PDFs"
# are exactly zero and its limit check then loops forever (found 2026-09-03:
# the nupdf route through genericpdf0 leaves them at zero, and stage 1 never
# returned).  The benchmark's fixed-beam production binary is untouched.
# Apply with:  cp -R DIS_v DIS_v_muflux  (inside $POWHEG_RES/..), then
#   patch -p0 -d $SOFTWARE/powheg/powheg-dis-main < patches/powheg-res-dis-v-muflux-lepton-flux.diff

--- DIS_v_muflux/lepton_flux.f.orig	2025-07-14 14:22:00
+++ DIS_v_muflux/lepton_flux.f	2026-09-03 10:32:16
@@ -13,22 +13,53 @@
       jac = (xmax-xmin)
       end
 
-
       subroutine pdf_lepton_beam(ih, mufact2, x, pdf )
-      implicit none
       include 'pwhg_pdf.h'
-!     input
-      integer ih                !Index of the incoming beam
-      real * 8 mufact2          !factorisation scale (squared)
-      real * 8 x                !x fraction
-!     output
-      real *8 pdf(-pdf_nparton:pdf_nparton)   !Array of pdfs
+      real * 8 lam5
+      integer iord,iset,maxsets
+      common/cgenericpdf/lam5,iord,iset,maxsets
 
-      pdf = 1e-8                !Do not set light quark pdfs to 0 otherwise the checklims is broken. This is in any case not used
+      integer(kind=4),intent(in) :: ih        !Index of the incoming beam
+      real(kind=8),intent(in)    :: mufact2   !factorisation scale (squared)
+      real(kind=8),intent(in)    :: x         !x fraction
+      real(kind=8),dimension(-pdf_nparton:pdf_nparton),
+     1 intent(out)               :: pdf
 
-!     COMMENT -- ADD THE FUNCTIONAL FORM YOU PREFER FOR THE FLAVOURS YOU NEED          
-      pdf(11)  = exp(-1d0/x**2)
-      pdf(-11)  = exp(-1d0/x**2)
-      pdf(12)  = 1d0
-      pdf(-12) = 1d0
+      integer(kind=4),save       :: LEPpdf=-1
+      logical,save               :: ini=.TRUE.
+
+      interface
+         real(kind=8) function powheginput(stringa)
+            character(len=*),dimension(*),intent(in) :: stringa
+         end function powheginput
+         logical(kind=c_bool) function generic_has_id(iset,id) 
+     1   bind(C,name="generic_has_id_")
+            use iso_c_binding, only: c_int, c_bool
+            integer(kind=c_int),intent(in) :: iset,id
+         end function generic_has_id
+      end interface
+
+      pdf = 1e-8                ! Do not set light quark pdfs to 0 otherwise
+                                ! the checklims is broken. This is in any 
+                                ! case not used
+      if(ini)then
+         leppdf=int(powheginput("#LEPpdf"),kind=4)
+         if(leppdf.lt.0)then
+            write(*,"(A)") 
+     1           "ERROR: Keyword LEPpdf missing in input card."
+            stop
+         end if
+         call genericpdfset(LEPpdf)
+         if(.NOT.generic_has_id(iset,ih))then
+            write(*,"(A23,I4,A15)") "ERROR: Neutrino flavour",ih, 
+     1                            " not available."
+            stop
+         end if
+         ini=.FALSE.
+      end if
+
+      call genericpdfset(LEPpdf)
+      call xf_pdgid(iset,ih,x,mufact2,pdf(ih))
+      pdf(ih)=pdf(ih)/x
+
       end
