# Apply from the repository root (variables from config.sh):
#   patch -p1 -d $GENIE_DIR < patches/genie-em-q2-floor-and-pythia8-teardown.diff
diff --git a/src/Framework/Utils/KineUtils.h b/src/Framework/Utils/KineUtils.h
index 74c400e80..3fe4ab1d1 100644
--- a/src/Framework/Utils/KineUtils.h
+++ b/src/Framework/Utils/KineUtils.h
@@ -111,7 +111,11 @@ namespace kinematics
    Range1D_t  InelYLim    (double El, double ml, double M);
    Range1D_t  InelYLim_X  (double El, double ml, double M, double x);
 
-   static const double kMinQ2Limit   = 0.02;  // GeV^2 // Q2 threshold relevant for em scattering events
+   // BENCHMARK BUILD (evgen-benchmark): raised from the upstream default 0.02 so that
+   // EM events are generated directly inside the fiducial region Q2 > 4 GeV^2
+   // (photon propagator makes full-phase-space generation ~0.5% efficient).
+   // Affects ALL EM channels (QE/RES/MEC/DIS) — revert to 0.02 for standard EM physics.
+   static const double kMinQ2Limit   = 4.0;  // GeV^2 // Q2 threshold relevant for em scattering events
   }
 
 } // kinematics namespace
diff --git a/src/Framework/Utils/Pythia8Singleton.cxx b/src/Framework/Utils/Pythia8Singleton.cxx
index 8596715cd..ef568cd09 100644
--- a/src/Framework/Utils/Pythia8Singleton.cxx
+++ b/src/Framework/Utils/Pythia8Singleton.cxx
@@ -53,6 +53,11 @@ Pythia8Singleton * Pythia8Singleton::Instance()
 #ifdef __GENIE_PYTHIA8_ENABLED__
     // actually create the one to be held
     fInstance->fPythia = new Pythia8::Pythia();
+    // BENCHMARK BUILD: evgen-benchmark stability convention — Pythia8 must
+    // not decay particles with ctau0 > 10 mm (K_S, Lambda, Sigma, Xi, Omega).
+    // Applies to every user of this instance (hadronizers and decayer).
+    fInstance->fPythia->readString("ParticleDecays:limitTau0 = on");
+    fInstance->fPythia->readString("ParticleDecays:tau0Max = 10.");
 #endif
   }
   return fInstance;
